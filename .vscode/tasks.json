{
  "version": "2.0.0",
  "tasks": [
    {
      // Finds the PC's IP for the phone and writes .dart_tool/dev_host.json.
      "label": "dev host",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run_dev.ps1",
        "-writeOnly"
      ],
      // Shown so you can see which address the app was built with.
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
