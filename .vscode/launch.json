{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // "dev host" writes the PC's IP so the phone can reach the server.
      "name": "Launch development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "dev host",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define-from-file=.dart_tool/dev_host.json"
      ]
    },
    {
      // Starts at onboarding, signed out, on every launch and hot restart.
      "name": "Launch development (fresh start)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "dev host",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define-from-file=.dart_tool/dev_host.json",
        "--dart-define=FRESH_START=true"
      ]
    },
    {
      "name": "Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": ["--flavor", "staging", "--target", "lib/main_staging.dart"]
    },
    {
      "name": "Launch production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": ["--flavor", "production", "--target", "lib/main_production.dart"]
    }
  ]
}
